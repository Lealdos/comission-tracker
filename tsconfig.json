{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    // shadcn/ui components import each other through "@/"; app code uses relative paths.
    "paths": { "@/*": ["./web/*"] },
    "types": ["bun", "vite/client"]
  },
  "include": ["shared", "server", "api", "*.ts"]
}
