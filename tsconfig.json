{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    // shadcn/ui components import each other through "@/"; app code uses relative paths.
    "paths": { "@/*": ["./web/*"] },
    // Ambient types for shared/, server/ and api/ (web/tsconfig.json lists its own). typeRoots is resolved from this
    // file, so `types` still resolves when Vercel compiles the function through a temporary tsconfig in /tmp that extends this one.
    "typeRoots": ["./node_modules/@types"],
    "types": ["bun"]
  },
  "include": ["shared", "server", "api", "*.ts"]
}
