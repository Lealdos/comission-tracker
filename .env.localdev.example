# Local development: copy to .env.localdev. `bun run dev` and the db:local:* scripts load only this file
# (Bun's --env-file), so the Neon production values in .env stay out of it.

# The Postgres in compose.yaml (OrbStack or Docker). No pooler locally, so both URLs are the same.
DATABASE_URL=postgresql://commission:commission@localhost:5432/commission
DATABASE_URL_UNPOOLED=postgresql://commission:commission@localhost:5432/commission

# Sign-in still uses Neon Auth, from the `development` Neon branch (never production), which trusts localhost:
#   neon env pull --branch development --file .env.localdev --env NEON_AUTH_BASE_URL
NEON_AUTH_BASE_URL=

# Any random value for local use: `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=

PORT=3000
