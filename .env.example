# Neon: `neon deploy` (or `neon env pull`) fills these in from the linked branch.
# DATABASE_URL is the pooled connection the app uses; Prisma Migrate uses DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Signs the session_data cookie the /api/auth proxy mints. Generate with `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=

PORT=3000
